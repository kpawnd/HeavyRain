<metro:MetroWindow x:Class="HeavyRain.ActionNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:metro="http://metro.mahapps.com/winfx/xaml/controls"
        Title="Heavy Rain" TitleCharacterCasing="Normal" ShowTitleBar="False"
        Width="500" SizeToContent="Height" MinHeight="220" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" WindowTransitionsEnabled="False"
        Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource AccentStrongBrush}" BorderThickness="1"
        FontFamily="Segoe UI" ContentRendered="Window_ContentRendered">
    <Border Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource AccentStrongBrush}" BorderThickness="0,3,0,0" Padding="28">
        <StackPanel>
            <TextBlock Text="HEAVY RAIN" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,0,0,16"/>
            <TextBlock x:Name="NoticeTitle" FontSize="24" FontWeight="Light" Margin="0,0,0,14"/>
            <TextBlock x:Name="NoticeMessage" Foreground="{StaticResource MutedBrush}" FontSize="13" LineHeight="21" Margin="0,0,0,24"/>
            <Button x:Name="DismissButton" Content="Got it" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" MinWidth="100" IsDefault="True" IsCancel="True" Click="Dismiss_Click"/>
        </StackPanel>
    </Border>
</metro:MetroWindow>

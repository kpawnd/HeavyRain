<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\HeavyRain.Core\HeavyRain.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MahApps.Metro" Version="2.4.11" />
    <Resource Include="Assets\kpawnd-avatar.png" />
    <Resource Include="Assets\heavy-rain.ico" />
    <Resource Include="Assets\dragon.png" />
    <EmbeddedResource Include="Assets\startup-chime.wav" LogicalName="HeavyRain.StartupChime.wav" />
    <EmbeddedResource Include="Assets\error-chime.wav" LogicalName="HeavyRain.ErrorChime.wav" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>

  <!-- The wiki address for signing in is kept out of this public repository: put it in an untracked
       HeavyRain.local.props (see HeavyRain.local.props.example). Without one, sign-in is off. -->
  <Import Project="HeavyRain.local.props" Condition="Exists('HeavyRain.local.props')" />
  <ItemGroup Condition="'$(HeavyRainWikiUrl)' != ''">
    <AssemblyMetadata Include="WikiUrl" Value="$(HeavyRainWikiUrl)" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\heavy-rain.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <Version>1.6.1</Version>
    <Product>Heavy Rain</Product>
    <AssemblyTitle>Heavy Rain</AssemblyTitle>
    <Authors>kpawnd</Authors>
    <Description>Local Deep Freeze and Anti-Executable controls using Faronics command-line tools.</Description>
  </PropertyGroup>

</Project>

<metro:MetroWindow x:Class="HeavyRain.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:metro="http://metro.mahapps.com/winfx/xaml/controls"
        Title="Heavy Rain" Icon="Assets/heavy-rain.ico" ShowIconOnTitleBar="False" TitleCharacterCasing="Normal" TitleBarHeight="38"
        WindowTitleBrush="{StaticResource CanvasBrush}" NonActiveWindowTitleBrush="{StaticResource CanvasBrush}"
        TitleForeground="{StaticResource MutedBrush}" GlowBrush="{StaticResource AccentStrongBrush}"
        Width="980" Height="760" MinWidth="840" MinHeight="660" WindowStartupLocation="CenterScreen"
        WindowTransitionsEnabled="False" Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
    <metro:MetroWindow.TitleTemplate>
        <DataTemplate><Grid/></DataTemplate>
    </metro:MetroWindow.TitleTemplate>
    <metro:MetroWindow.RightWindowCommands>
        <metro:WindowCommands ShowSeparators="False">
            <TextBlock x:Name="MachineNameText" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <Button x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click" ToolTip="Check everything again" Margin="0,0,6,0" Padding="12,0"
                    Style="{DynamicResource MahApps.Styles.Button.WindowCommands}" Foreground="{StaticResource TextBrush}"/>
        </metro:WindowCommands>
    </metro:MetroWindow.RightWindowCommands>
    <Grid Background="{StaticResource CanvasBrush}">
    <Grid Margin="30,0,30,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Image Source="Assets/dragon.png" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Purple dragon"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                <TextBlock Text="Heavy Rain" FontSize="32" FontWeight="Light"/>
                <TextBlock Text="Deep Freeze &amp; Anti-Executable" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="1,2,0,0"/>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="DemoBanner" Grid.Row="1" Visibility="Collapsed" Text="Demo · sample data, no commands sent" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,0,0,12"/>
        <metro:MetroAnimatedTabControl x:Name="MainTabs" Grid.Row="2" BorderThickness="0" Background="Transparent" Padding="0,18,0,0" SelectedIndex="0"
                                       ItemContainerStyle="{StaticResource PivotTab}">
            <TabItem Header="deep freeze">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,4,12,0">
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border x:Name="StateStripe" Background="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                                <StackPanel Grid.Column="1" Margin="17,0,28,0">
                                    <TextBlock Text="Protection state" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="StateText" Text="Checking…" FontSize="46" FontWeight="Light" Margin="-2,-5,0,0"/>
                                    <TextBlock x:Name="StateNoteText" Visibility="Collapsed" FontSize="13" Margin="0,4,0,0" AutomationProperties.Name="How long the PC has been Thawed"/>
                                    <TextBlock x:Name="StateDetailText" Visibility="Collapsed" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="CheckedText" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Cloud policy" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="PolicyNameText" Text="Checking…" FontSize="22" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock x:Name="PolicySourceText" Visibility="Collapsed" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Version" Style="{StaticResource Label}"/>
                                        <TextBlock x:Name="VersionText" Text="Unavailable" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Licence" Style="{StaticResource Label}"/>
                                        <TextBlock x:Name="LicenseText" Text="Checking…" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock Text="Scheduled" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="ScheduleText" Text="Checking…" FontSize="12" LineHeight="19"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,22,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Change protection" Style="{StaticResource SectionTitle}"/>
                                    <PasswordBox x:Name="PasswordInput" MaxLength="63" FontSize="16" PasswordChanged="Password_Changed" Margin="0,0,0,16"
                                                 metro:TextBoxHelper.Watermark="Command-line password" metro:TextBoxHelper.UseFloatingWatermark="True"
                                                 metro:TextBoxHelper.ClearTextButton="True" metro:PasswordBoxHelper.CapsLockWarningToolTip="Caps Lock is on"
                                                 ToolTip="A Command Line password from the Deep Freeze policy, not the Workstation password." AutomationProperties.Name="Deep Freeze command-line password"/>
                                    <!-- The label names what switching on does; off means the change waits for the next restart. -->
                                    <metro:ToggleSwitch x:Name="RestartSwitch" OffContent="Restart immediately" OnContent="Restart immediately" Margin="0,0,0,18"
                                                        ToolTip="Off: the change applies at the next restart." AutomationProperties.Name="Restart immediately after confirmation"/>
                                    <!-- Only the actions that can apply to the current state are shown; see RenderStatus. -->
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="ThawButton" Content="Thaw PC" Click="Thaw_Click" MinWidth="200" Margin="0,0,12,0"
                                                ToolTip="Stays Thawed until you freeze it."/>
                                        <Button x:Name="FreezeButton" Content="Freeze PC" Click="Freeze_Click" MinWidth="200"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="PendingPanel" Grid.Column="2">
                                    <TextBlock Text="Pending" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock x:Name="PendingText" Text="Checking…" FontSize="16" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="PendingDetailText" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="anti-executable" x:Name="AecTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,4,12,0">
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border x:Name="AecStateStripe" Background="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                                <StackPanel Grid.Column="1" Margin="17,0,28,0">
                                    <TextBlock Text="Execution protection" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="AecStateText" Text="Checking…" FontSize="46" FontWeight="Light" Margin="-2,-5,0,0"/>
                                    <TextBlock x:Name="AecDetailText" Visibility="Collapsed" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="AecPolicyNoteText" Visibility="Collapsed" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0"
                                               Text="Unknown programs can still run."/>
                                    <TextBlock x:Name="AecCheckedText" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Anti-Executable version" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="AecVersionText" Text="Unavailable" FontSize="22" Foreground="{StaticResource AccentBrush}"/>
                                <StackPanel Margin="0,18,0,0">
                                    <TextBlock Text="Policy" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="AecPolicyText" Text="Checking…" FontSize="12" LineHeight="19"/>
                                    <TextBlock x:Name="AecPolicySourceText" Visibility="Collapsed" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel x:Name="AecAccountPanel" Margin="0,16,0,0" Visibility="Collapsed">
                                    <TextBlock Text="Your account" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="AecAccountText" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,22,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Protection" Style="{StaticResource SectionTitle}"/>
                                    <PasswordBox x:Name="AecPasswordInput" MaxLength="255" FontSize="16" Margin="0,0,0,16"
                                                 metro:TextBoxHelper.Watermark="Anti-Executable password" metro:TextBoxHelper.UseFloatingWatermark="True"
                                                 metro:TextBoxHelper.ClearTextButton="True" metro:PasswordBoxHelper.CapsLockWarningToolTip="Caps Lock is on"
                                                 ToolTip="The AE password from your policy's User Settings, if one is set." AutomationProperties.Name="Anti-Executable password"/>
                                    <WrapPanel Margin="0,0,0,12">
                                        <Button x:Name="AecEnableButton" Content="Enable" Click="AecEnable_Click" Margin="0,0,10,8"/>
                                        <Button x:Name="AecDisableButton" Content="Disable" Click="AecDisable_Click" Margin="0,0,10,8"/>
                                        <Button x:Name="AecQueryButton" Content="Check status" Click="AecQuery_Click" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="AecPendingText" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Maintenance" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="1 hour" FontSize="22" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,14"/>
                                    <Button x:Name="AecMaintenanceButton" Content="Start maintenance" Click="AecMaintenance_Click" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="installation">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,4,12,0">
                        <TextBlock Text="Command-line interface" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="DfcPathText" Text="Searching…" FontFamily="Consolas" FontSize="13"/>
                        <WrapPanel Margin="0,18,0,30">
                            <Button x:Name="BrowseButton" Content="Locate DFC.exe" Click="Browse_Click" Margin="0,0,12,0"/>
                            <Button x:Name="DetectButton" Content="Auto-detect" Click="Detect_Click" Margin="0,0,12,0"/>
                            <Button Content="DFC documentation ↗" Click="Documentation_Click"/>
                        </WrapPanel>
                        <TextBlock Text="Components" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="ComponentsSummaryText" Text="Checking…" FontSize="13" Margin="0,0,0,10"/>
                        <ItemsControl x:Name="ComponentsList" AutomationProperties.Name="Faronics drivers and services" Margin="0,0,0,30">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontFamily="Consolas" FontSize="13"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Role}" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding StateText}" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Tone}" Value="Good"><Setter TargetName="Dot" Property="Fill" Value="{StaticResource SuccessBrush}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Tone}" Value="Bad"><Setter TargetName="Dot" Property="Fill" Value="{StaticResource ErrorBrush}"/></DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Installed products" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="InstallationText" FontSize="13" LineHeight="22"/>
                        <TextBlock Text="Anti-Executable interface" Style="{StaticResource SectionTitle}" Margin="0,30,0,14"/>
                        <TextBlock x:Name="AecPathText" Text="Searching…" FontFamily="Consolas" FontSize="13"/>
                        <TextBlock x:Name="AecInstallationDetailText" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0"/>
                        <WrapPanel Margin="0,18,0,0">
                            <Button x:Name="AecBrowseButton" Content="Locate AEC.exe" Click="AecBrowse_Click" Margin="0,0,12,10"/>
                            <Button x:Name="AecDetectButton" Content="Auto-detect AEC" Click="AecDetect_Click" Margin="0,0,12,10"/>
                            <Button Content="AEC documentation ↗" Click="AecDocumentation_Click" Margin="0,0,0,10"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="activity">
                <metro:MetroAnimatedSingleRowTabControl x:Name="ActivityTabs" BorderThickness="0" Background="Transparent" Padding="0,10,0,0" SelectedIndex="0"
                                                        ItemContainerStyle="{StaticResource SubPivotTab}" Margin="0,4,0,0">
                    <TabItem Header="session">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Button x:Name="ExportButton" Content="Export diagnostics" Click="Export_Click" HorizontalAlignment="Left" Margin="0,0,0,16"/>
                            <TextBox x:Name="ActivityText" Grid.Row="1" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Padding="0" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Session activity log"/>
                        </Grid>
                    </TabItem>
                    <TabItem Header="deep freeze">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock x:Name="DfHistorySourceText" Visibility="Collapsed" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <ListBox x:Name="DfHistoryList" Grid.Row="1" Style="{StaticResource ActivityList}" ItemContainerStyle="{StaticResource ActivityListItem}"
                                     SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Deep Freeze history">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="{Binding FullDetail}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border x:Name="Stripe" Background="{StaticResource LineBrush}" Margin="0,2,0,2" CornerRadius="2"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Time}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="10,2,0,0"/>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Tone}" Value="Frozen"><Setter TargetName="Stripe" Property="Background" Value="{StaticResource AccentBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Tone}" Value="Thawed"><Setter TargetName="Stripe" Property="Background" Value="{StaticResource WarningBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Tone}" Value="Request"><Setter TargetName="Stripe" Property="Background" Value="{StaticResource TextBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Tone}" Value="Failed">
                                                <Setter TargetName="Stripe" Property="Background" Value="{StaticResource ErrorBrush}"/>
                                                <Setter TargetName="Title" Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>
                    <TabItem Header="anti-executable log">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Button x:Name="AecAllowButton" Content="Allow selected file" Click="AecAllow_Click" HorizontalAlignment="Left" Margin="0,0,0,16"/>
                            <TextBlock x:Name="AecActivitySourceText" Grid.Row="1" Visibility="Collapsed" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <ListBox x:Name="AecActivityList" Grid.Row="2" Style="{StaticResource ActivityList}" ItemContainerStyle="{StaticResource ActivityListItem}"
                                     SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.Name="Recent Anti-Executable activity">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="{Binding FullDetail}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontSize="13" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                                    <Run Text="{Binding Title, Mode=OneWay}"/><Run Text="{Binding Subject, Mode=OneWay}" Foreground="{StaticResource AccentBrush}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>
                </metro:MetroAnimatedSingleRowTabControl>
            </TabItem>
        </metro:MetroAnimatedTabControl>
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Button x:Name="GitHubButton" Click="GitHub_Click" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0" ToolTip="Open github.com/kpawnd" AutomationProperties.Name="Open kpawnd's GitHub profile">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="4" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3" x:Name="LinkBorder">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="LinkBorder" Property="Background" Value="{StaticResource AccentSurfaceBrush}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="LinkBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <Image Source="Assets/kpawnd-avatar.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="kpawnd GitHub avatar"/>
                    <TextBlock Text="@kpawnd" FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
        <metro:MetroProgressBar x:Name="ActivityProgress" VerticalAlignment="Bottom" Height="4"
                                IsIndeterminate="False" Visibility="Collapsed" IsHitTestVisible="False"
                                Foreground="{StaticResource AccentBrush}" Background="{StaticResource AccentSurfaceBrush}"
                                AutomationProperties.Name="Operation in progress"/>
    </Grid>
</metro:MetroWindow>

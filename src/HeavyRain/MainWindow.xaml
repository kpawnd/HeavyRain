<metro:MetroWindow x:Class="HeavyRain.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:metro="http://metro.mahapps.com/winfx/xaml/controls"
        Title="Heavy Rain" Icon="Assets/heavy-rain.ico" TitleCharacterCasing="Normal" TitleBarHeight="34"
        WindowTitleBrush="{StaticResource RailBrush}" NonActiveWindowTitleBrush="{StaticResource RailBrush}"
        TitleForeground="{StaticResource MutedBrush}" GlowBrush="{StaticResource AccentStrongBrush}"
        Width="1120" Height="850" MinWidth="900" MinHeight="650" WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions><RowDefinition Height="3"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="{StaticResource AccentStrongBrush}"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource RailBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="22,28,22,22">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <Grid Width="42" Height="42" HorizontalAlignment="Left" Margin="0,0,0,16">
                            <Path Stroke="{StaticResource AccentBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 12,4 L 4,20 M 26,4 L 11,34 M 40,4 L 25,34 M 40,20 L 32,36"/>
                        </Grid>
                        <TextBlock Text="Heavy Rain" FontSize="26" FontWeight="Light"/>
                        <TextBlock Text="PROTECTION CONTROL" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="1,6,0,34"/>
                        <Border Background="{StaticResource AccentSurfaceBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="3,0,0,0" Padding="12,13">
                            <TextBlock Text="Overview" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="THIS COMPUTER" Style="{StaticResource Label}" Margin="0,30,0,8"/>
                        <TextBlock x:Name="MachineNameText" FontSize="18"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2">
                        <Button Content="Documentation ↗" Click="Documentation_Click" Padding="8,9" FontSize="12" HorizontalContentAlignment="Left" Margin="0,0,0,22"/>
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Image Source="Assets/kpawnd-avatar.png" Width="36" Height="36" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="kpawnd GitHub avatar"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="CREATED BY" FontSize="9" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="@kpawnd" FontSize="14" Foreground="{StaticResource AccentBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="30,26,30,24">
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Protection" FontSize="34" FontWeight="Light"/>
                            <TextBlock Text="Current state. Next restart. All in one place." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,6,12,0"/>
                        </StackPanel>
                        <Button x:Name="RefreshButton" Grid.Column="1" Content="↻  Refresh" Click="Refresh_Click" VerticalAlignment="Center"/>
                    </Grid>
                    <Border x:Name="DemoBanner" Visibility="Collapsed" Background="{StaticResource AccentSurfaceBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="3,0,0,0" Padding="12" Margin="0,0,0,14">
                        <TextBlock Text="DEMO  /  Sample status. No changes are sent to this computer." Foreground="{StaticResource AccentBrush}" FontSize="12"/>
                    </Border>
                    <Border Style="{StaticResource Panel}" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border x:Name="StateStripe" Background="{StaticResource MutedBrush}"/>
                            <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                <TextBlock Text="CURRENT PROTECTION" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="StateText" Text="Checking…" FontSize="46" FontWeight="Light"/>
                                <TextBlock x:Name="StateDetailText" Text="Looking for Deep Freeze command-line control." Margin="0,5,0,10" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                                <TextBlock x:Name="CheckedText" Text="Not queried yet" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                <Border Background="{StaticResource InsetBrush}" Padding="12" Margin="0,18,0,0">
                                    <StackPanel>
                                        <TextBlock Text="NEXT BOOT REQUEST" Style="{StaticResource Label}" Margin="0,0,0,5"/>
                                        <TextBlock x:Name="PendingText" Text="No request made in this session. Existing next-boot settings are not queried." FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="Boot controls" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Choose the state for the next boot. A restart applies the change." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,20"/>
                                <TextBlock Text="DEEP FREEZE PASSWORD" Style="{StaticResource Label}"/>
                                <PasswordBox x:Name="PasswordInput" MaxLength="63" FontSize="16" PasswordChanged="Password_Changed" ToolTip="Use a Deep Freeze password with command-line rights, not your Windows password or a one-time password." AutomationProperties.Name="Deep Freeze command-line password"/>
                                <TextBlock Text="Command-line rights required. Never saved; cleared after every request." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,18"/>
                                <CheckBox x:Name="RestartCheck" FontSize="12" Margin="0,0,0,18">
                                    <TextBlock Text="Restart immediately after confirmation" FontSize="12"/>
                                </CheckBox>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button x:Name="FreezeButton" Content="Freeze PC" Style="{StaticResource PrimaryButton}" Click="Freeze_Click"/>
                                    <Button x:Name="ThawButton" Grid.Column="2" Content="Thaw PC" BorderBrush="{StaticResource AccentBrush}" Foreground="{StaticResource AccentBrush}" Click="Thaw_Click"/>
                                </Grid>
                                <TextBlock x:Name="ControlHintText" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/>
                                <TextBlock Text="Local changes may put a Cloud-managed PC out of sync with its assigned policy." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="Connection" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="CLOUD POLICY" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="PolicyNameText" Text="Checking…" FontSize="18" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock x:Name="PolicySourceText" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,20"/>
                                <TextBlock Text="CONTROL INTERFACE" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="DfcPathText" Text="Searching…" FontSize="12"/>
                                <WrapPanel Margin="0,14,0,18">
                                    <Button x:Name="BrowseButton" Content="Locate DFC.exe" Click="Browse_Click" FontSize="12" Padding="10,8" Margin="0,0,8,6"/>
                                    <Button x:Name="DetectButton" Content="Auto-detect" Click="Detect_Click" FontSize="12" Padding="10,8" Margin="0,0,0,6"/>
                                </WrapPanel>
                                <TextBlock Text="DEEP FREEZE VERSION" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="VersionText" Text="Unavailable" FontSize="12" Margin="0,0,0,20"/>
                                <TextBlock Text="INSTALLATION EVIDENCE" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="InstallationText" FontSize="12"/>
                                <TextBlock Text="A Cloud agent or registered driver alone does not establish whether this PC is frozen." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border x:Name="ResultBanner" Background="{StaticResource AccentSurfaceBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="3,0,0,0" Padding="14" Margin="0,0,0,18" Visibility="Collapsed">
                        <TextBlock x:Name="ResultText" FontSize="13"/>
                    </Border>
                    <Border Style="{StaticResource Panel}" Padding="18">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Session activity" FontSize="18" VerticalAlignment="Center"/>
                                <Button x:Name="ExportButton" Grid.Column="1" Content="Export diagnostics" Click="Export_Click" FontSize="12" Padding="10,8"/>
                            </Grid>
                            <TextBox x:Name="ActivityText" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Height="92" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0" AutomationProperties.Name="Session activity log"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="FooterText" Text="Ready" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,16,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</metro:MetroWindow>

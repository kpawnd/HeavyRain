<metro:MetroWindow x:Class="HeavyRain.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:metro="http://metro.mahapps.com/winfx/xaml/controls"
        Title="Heavy Rain" Icon="Assets/heavy-rain.ico" TitleCharacterCasing="Normal" TitleBarHeight="30"
        WindowTitleBrush="{StaticResource CanvasBrush}" NonActiveWindowTitleBrush="{StaticResource CanvasBrush}"
        TitleForeground="{StaticResource MutedBrush}" GlowBrush="{StaticResource AccentStrongBrush}"
        Width="960" Height="740" MinWidth="820" MinHeight="640" WindowStartupLocation="CenterScreen"
        WindowTransitionsEnabled="False" Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
    <Grid Background="{StaticResource CanvasBrush}">
    <Grid Margin="30,12,30,16" Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Image Source="Assets/dragon.png" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Purple dragon"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                <TextBlock Text="Heavy Rain" FontSize="32" FontWeight="Light"/>
                <TextBlock Text="Deep Freeze &amp; Anti-Executable" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="1,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock x:Name="MachineNameText" FontSize="12" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                <Button x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click" Padding="16,4" MinHeight="30"/>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="DemoBanner" Grid.Row="1" Visibility="Collapsed" Text="Demo · sample data, no commands sent" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,0,0,12"/>
        <TabControl Grid.Row="2" BorderThickness="0" Background="Transparent" Padding="0,18,0,0" SelectedIndex="0">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                    <Setter Property="FontSize" Value="25"/>
                    <Setter Property="FontWeight" Value="Light"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Background="Transparent" Padding="0,0,26,12">
                                    <TextBlock Text="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" FontWeight="{TemplateBinding FontWeight}" FontSize="{TemplateBinding FontSize}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></Trigger>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.ItemContainerStyle>
            <TabItem Header="deep freeze">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,4,12,0">
                        <Grid Margin="0,0,0,26">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border x:Name="StateStripe" Background="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                                <StackPanel Grid.Column="1" Margin="17,0,28,0">
                                    <TextBlock Text="Protection state" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="StateText" Text="Checking…" FontSize="46" FontWeight="Light" Margin="-2,-5,0,0"/>
                                    <TextBlock x:Name="StateDetailText" Visibility="Collapsed" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="CheckedText" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Cloud policy" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="PolicyNameText" Text="Checking…" FontSize="22" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock x:Name="PolicySourceText" Visibility="Collapsed" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <StackPanel Margin="0,18,0,0">
                                    <TextBlock Text="Deep Freeze version" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="VersionText" Text="Unavailable" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,22,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Next restart" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Deep Freeze password" Style="{StaticResource Label}"/>
                                    <PasswordBox x:Name="PasswordInput" MaxLength="63" FontSize="16" PasswordChanged="Password_Changed" ToolTip="A Deep Freeze password with command-line rights." AutomationProperties.Name="Deep Freeze command-line password" Margin="0,0,0,16"/>
                                    <CheckBox x:Name="RestartCheck" Content="Restart immediately after confirmation" FontSize="12" Margin="0,0,0,18"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Button x:Name="FreezeButton" Content="Freeze PC" Style="{StaticResource PrimaryButton}" Click="Freeze_Click"/>
                                        <Button x:Name="ThawButton" Grid.Column="2" Content="Thaw PC" Click="Thaw_Click"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Last request" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock x:Name="PendingText" Text="None" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border x:Name="ResultBanner" BorderBrush="{StaticResource AccentBrush}" BorderThickness="3,0,0,0" Padding="12,0,0,0" Margin="0,22,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="ResultText" FontSize="12"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="anti-executable" x:Name="AecTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,4,12,0">
                        <Grid Margin="0,0,0,26">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border x:Name="AecStateStripe" Background="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                                <StackPanel Grid.Column="1" Margin="17,0,28,0">
                                    <TextBlock Text="Execution protection" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="AecStateText" Text="Checking…" FontSize="46" FontWeight="Light" Margin="-2,-5,0,0"/>
                                    <TextBlock x:Name="AecDetailText" Visibility="Collapsed" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="AecPolicyNoteText" Visibility="Collapsed" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0"
                                               Text="Unknown programs can still run."/>
                                    <TextBlock x:Name="AecCheckedText" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Anti-Executable version" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="AecVersionText" Text="Unavailable" FontSize="22" Foreground="{StaticResource AccentBrush}"/>
                                <StackPanel Margin="0,18,0,0">
                                    <TextBlock Text="Policy" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="AecPolicyText" Text="Checking…" FontSize="12" LineHeight="19"/>
                                    <TextBlock x:Name="AecPolicySourceText" Visibility="Collapsed" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,22,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Protection" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Anti-Executable password" Style="{StaticResource Label}"/>
                                    <PasswordBox x:Name="AecPasswordInput" MaxLength="255" FontSize="16" AutomationProperties.Name="Anti-Executable password" Margin="0,0,0,16"
                                                 ToolTip="The AE password from your policy's User Settings, if one is set."/>
                                    <WrapPanel Margin="0,0,0,12">
                                        <Button x:Name="AecEnableButton" Content="Enable" Style="{StaticResource PrimaryButton}" Click="AecEnable_Click" Margin="0,0,10,8"/>
                                        <Button x:Name="AecDisableButton" Content="Disable" Click="AecDisable_Click" Margin="0,0,10,8"/>
                                        <Button x:Name="AecQueryButton" Content="Check status" Click="AecQuery_Click" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="AecPendingText" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Maintenance" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="1 hour" FontSize="22" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,14"/>
                                    <Button x:Name="AecMaintenanceButton" Content="Start maintenance" Click="AecMaintenance_Click" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,22,0,0" Margin="0,26,0,0">
                            <StackPanel>
                                <TextBlock Text="Recent activity" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="AecActivitySourceText" Visibility="Collapsed" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <ListBox x:Name="AecActivityList" Height="230" Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                         Foreground="{StaticResource TextBrush}" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         AutomationProperties.Name="Recent Anti-Executable activity">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Summary}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0" Padding="10,7">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource PanelBrush}"/></Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentSurfaceBrush}"/>
                                                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ToolTip="{Binding FullDetail}">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Time}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock FontSize="13" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Title, Mode=OneWay}"/><Run Text="{Binding Subject, Mode=OneWay}" Foreground="{StaticResource AccentBrush}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button x:Name="AecAllowButton" Content="Allow selected file" Click="AecAllow_Click" HorizontalAlignment="Left" Margin="0,12,0,8"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="installation">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,4,12,0">
                        <TextBlock Text="Command-line interface" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="DfcPathText" Text="Searching…" FontFamily="Consolas" FontSize="13"/>
                        <WrapPanel Margin="0,18,0,30">
                            <Button x:Name="BrowseButton" Content="Locate DFC.exe" Click="Browse_Click" Margin="0,0,12,0"/>
                            <Button x:Name="DetectButton" Content="Auto-detect" Click="Detect_Click"/>
                        </WrapPanel>
                        <TextBlock Text="Installed components" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="InstallationText" FontSize="13" LineHeight="22"/>
                        <Button Content="DFC documentation ↗" Click="Documentation_Click" HorizontalAlignment="Left" Margin="0,24,0,0"/>
                        <TextBlock Text="Anti-Executable interface" Style="{StaticResource SectionTitle}" Margin="0,30,0,14"/>
                        <TextBlock x:Name="AecPathText" Text="Searching…" FontFamily="Consolas" FontSize="13"/>
                        <TextBlock x:Name="AecInstallationDetailText" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0"/>
                        <WrapPanel Margin="0,18,0,0">
                            <Button x:Name="AecBrowseButton" Content="Locate AEC.exe" Click="AecBrowse_Click" Margin="0,0,12,10"/>
                            <Button x:Name="AecDetectButton" Content="Auto-detect AEC" Click="AecDetect_Click" Margin="0,0,12,10"/>
                            <Button Content="AEC documentation ↗" Click="AecDocumentation_Click" Margin="0,0,0,10"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="activity">
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Button x:Name="ExportButton" Content="Export diagnostics" Click="Export_Click" HorizontalAlignment="Left" Margin="0,0,0,16"/>
                    <TextBox x:Name="ActivityText" Grid.Row="1" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Padding="0" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Session activity log"/>
                </Grid>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Button x:Name="GitHubButton" Click="GitHub_Click" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0" ToolTip="Open github.com/kpawnd" AutomationProperties.Name="Open kpawnd's GitHub profile">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="4" BorderBrush="Transparent" BorderThickness="1" x:Name="LinkBorder">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="LinkBorder" Property="Background" Value="{StaticResource AccentSurfaceBrush}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="LinkBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <Image Source="Assets/kpawnd-avatar.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="kpawnd GitHub avatar"/>
                    <TextBlock Text="@kpawnd" FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
        <metro:MetroProgressBar x:Name="ActivityProgress" VerticalAlignment="Bottom" Height="4"
                                IsIndeterminate="False" Visibility="Collapsed" IsHitTestVisible="False"
                                Foreground="{StaticResource AccentBrush}" Background="{StaticResource AccentSurfaceBrush}"
                                AutomationProperties.Name="Operation in progress"/>
    </Grid>
</metro:MetroWindow>

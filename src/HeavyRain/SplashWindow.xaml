<metro:MetroWindow x:Class="HeavyRain.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:metro="http://metro.mahapps.com/winfx/xaml/controls"
        Title="Heavy Rain — loading" Icon="Assets/heavy-rain.ico" Width="640" Height="450" ResizeMode="NoResize"
        ShowTitleBar="False" WindowStartupLocation="CenterScreen" WindowTransitionsEnabled="False"
        Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
        GlowBrush="{StaticResource AccentStrongBrush}" FontFamily="Segoe UI" UseLayoutRounding="True">
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions><RowDefinition Height="3"/><RowDefinition Height="*"/><RowDefinition Height="4"/></Grid.RowDefinitions>
        <Border Background="{StaticResource AccentStrongBrush}"/>
        <Grid Grid.Row="1" Margin="36,28,36,26">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
                <StackPanel>
                    <TextBlock Text="HEAVY RAIN" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="Starting up" FontSize="30" FontWeight="Light" Margin="0,9,0,0"/>
                </StackPanel>
                <Button Content="×" Click="Close_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-16,-24,0" Padding="8,0" MinHeight="28" Width="28" FontSize="20" Background="Transparent" BorderThickness="0" ToolTip="Cancel startup" AutomationProperties.Name="Cancel startup"/>
            </Grid>
            <Grid Grid.Row="1" ClipToBounds="True" Margin="0,16,0,18">
            <Grid x:Name="CreditPanel" VerticalAlignment="Center">
                <Grid.RenderTransform><TranslateTransform x:Name="CreditOffset"/></Grid.RenderTransform>
                <Grid.ColumnDefinitions><ColumnDefinition Width="108"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border BorderThickness="0" Padding="0">
                    <Image Source="Assets/kpawnd-avatar.png" Width="98" Height="98" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="kpawnd GitHub profile image"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="CREATED BY" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="@kpawnd" Foreground="{StaticResource AccentBrush}" FontSize="34" FontWeight="Light" Margin="0,4,0,5"/>
                    <TextBlock Text="github.com/kpawnd" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </Grid>
            <Border x:Name="LogPanel" Visibility="Collapsed" Opacity="0" Background="Transparent" BorderThickness="0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Startup log" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                    </Grid>
                    <ScrollViewer x:Name="LogScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="LogEntries" AutomationProperties.Name="Startup activity">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource AccentBrush}" Opacity="0.8"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Message}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
            </Grid>
            <StackPanel Grid.Row="2">
                <TextBlock x:Name="LoadingText" Text="Starting local protection tools…" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>
        <metro:MetroProgressBar Grid.Row="2" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" Background="{StaticResource AccentSurfaceBrush}" Height="4"/>
    </Grid>
</metro:MetroWindow>

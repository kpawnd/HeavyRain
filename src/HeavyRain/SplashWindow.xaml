<metro:MetroWindow x:Class="HeavyRain.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:metro="http://metro.mahapps.com/winfx/xaml/controls"
        Title="Heavy Rain — loading" Icon="Assets/heavy-rain.ico" Width="640" Height="450" ResizeMode="NoResize"
        ShowTitleBar="False" WindowStartupLocation="CenterScreen" WindowTransitionsEnabled="False"
        Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
        GlowBrush="{StaticResource AccentStrongBrush}" FontFamily="Segoe UI" UseLayoutRounding="True">
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions><RowDefinition Height="3"/><RowDefinition Height="*"/><RowDefinition Height="4"/></Grid.RowDefinitions>
        <Border Background="{StaticResource AccentStrongBrush}"/>
        <Grid Grid.Row="1" Margin="36,28,36,26">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
                <StackPanel>
                    <TextBlock Text="HEAVY RAIN" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="Starting up" FontSize="30" FontWeight="Light" Margin="0,9,0,0"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" ClipToBounds="True" Margin="0,16,0,18">
            <Grid x:Name="CreditPanel" VerticalAlignment="Center">
                <Grid.RenderTransform><TranslateTransform x:Name="CreditOffset"/></Grid.RenderTransform>
                <Grid.ColumnDefinitions><ColumnDefinition Width="108"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border BorderThickness="0" Padding="0">
                    <Image Source="Assets/kpawnd-avatar.png" Width="98" Height="98" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="kpawnd GitHub profile image"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="CREATED BY" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="@kpawnd" Foreground="{StaticResource AccentBrush}" FontSize="34" FontWeight="Light" Margin="0,4,0,5"/>
                    <TextBlock Text="github.com/kpawnd" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </Grid>
            <Border x:Name="LogPanel" Visibility="Collapsed" Opacity="0" Background="Transparent" BorderThickness="0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Startup log" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                    </Grid>
                    <!-- Lines fade out towards the top edge; the view glides down as lines arrive. -->
                    <ScrollViewer x:Name="LogScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                        <ScrollViewer.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="Black" Offset="0.22"/>
                                <GradientStop Color="Black" Offset="1"/>
                            </LinearGradientBrush>
                        </ScrollViewer.OpacityMask>
                        <ItemsControl x:Name="LogEntries" AutomationProperties.Name="Startup activity" Margin="0,40,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Each line rises into place and fades up while a soft wipe reveals its text.
                                         Everything animates transforms and opacity only, so nothing re-lays out mid-animation. -->
                                    <Grid Margin="0,0,0,7" Opacity="0" AutomationProperties.Name="{Binding Message}">
                                        <Grid.RenderTransform><TranslateTransform Y="12"/></Grid.RenderTransform>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.Triggers>
                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.45">
                                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.6">
                                                            <DoubleAnimation.EasingFunction><QuinticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="Line" Storyboard.TargetProperty="(UIElement.OpacityMask).(GradientBrush.GradientStops)[0].(GradientStop.Offset)"
                                                                         From="-0.25" To="1" Duration="0:0:0.7">
                                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="Line" Storyboard.TargetProperty="(UIElement.OpacityMask).(GradientBrush.GradientStops)[1].(GradientStop.Offset)"
                                                                         From="0" To="1.25" Duration="0:0:0.7">
                                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Grid.Triggers>
                                        <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource AccentBrush}" Opacity="0.8"/>
                                        <!-- The host fades in and out with the active line; the dot inside breathes. -->
                                        <Border x:Name="PulseHost" Grid.Column="1" Opacity="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,5,0,0">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}">
                                                <Ellipse.Triggers>
                                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.8">
                                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Ellipse.Triggers>
                                            </Ellipse>
                                        </Border>
                                        <TextBlock x:Name="Line" Grid.Column="2" Text="{Binding Message}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextBrush}" Opacity="0.66" TextWrapping="Wrap">
                                            <TextBlock.OpacityMask>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="Black" Offset="-0.25"/>
                                                    <GradientStop Color="Transparent" Offset="0"/>
                                                </LinearGradientBrush>
                                            </TextBlock.OpacityMask>
                                        </TextBlock>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsResult}" Value="True">
                                            <Setter TargetName="Line" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="PulseHost" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25"/>
                                                        <DoubleAnimation Storyboard.TargetName="Line" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="PulseHost" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                                        <DoubleAnimation Storyboard.TargetName="Line" Storyboard.TargetProperty="Opacity" To="0.66" Duration="0:0:0.8">
                                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
            </Grid>
            <StackPanel Grid.Row="2">
                <TextBlock x:Name="LoadingText" Text="Starting local protection tools…" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>
        <metro:MetroProgressBar Grid.Row="2" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" Background="{StaticResource AccentSurfaceBrush}" Height="4"/>
    </Grid>
</metro:MetroWindow>
